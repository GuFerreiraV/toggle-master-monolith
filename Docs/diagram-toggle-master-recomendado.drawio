                <!-- Regras dos security groups -->
                <mxCell id="sg-ec2-rules" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#DD3522;fillColor=#FFFFFF;align=left;verticalAlign=top;rounded=1;spacingLeft=8;" value="&lt;b&gt;SG-EC2 — Regras de entrada&lt;/b&gt;&lt;ul style=&quot;margin:4px 0;padding-left:18px&quot;&gt;&lt;li&gt;TCP 80 ⬅ 0.0.0.0/0 (HTTP)&lt;/li&gt;&lt;li&gt;TCP 443 ⬅ 0.0.0.0/0 (HTTPS)&lt;/li&gt;&lt;li&gt;&lt;b&gt;TCP 5000 ⬅ 0.0.0.0/0 (Gunicorn)&lt;/b&gt;&lt;/li&gt;&lt;li&gt;TCP 22 ⬅ MEU_IP/32 (SSH)&lt;/li&gt;&lt;/ul&gt;Saída: todo tráfego (padrão)" vertex="1">
