                <mxCell id="note-env" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Configuração na EC2 (via SSH)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;export DB_HOST=&amp;lt;endpoint-do-rds&amp;gt;&lt;br&gt;export DB_NAME=togglemaster&lt;br&gt;export DB_USER=&amp;lt;usuario&amp;gt;&lt;br&gt;export DB_PASSWORD=&amp;lt;senha&amp;gt;&lt;br&gt;&lt;br&gt;gunicorn --bind 0.0.0.0:5000 app:app&lt;/font&gt;&lt;br&gt;&lt;br&gt;Validação:&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;http://&amp;lt;ip-publico-ec2&amp;gt;:5000/health&lt;/font&gt;" vertex="1">
