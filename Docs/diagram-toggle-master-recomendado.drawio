                </mxCell>
                <mxCell id="sg-rds-rules" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#DD3522;fillColor=#FFFFFF;align=left;verticalAlign=top;rounded=1;spacingLeft=8;" value="&lt;b&gt;SG-RDS — Regras de entrada&lt;/b&gt;&lt;ul style=&quot;margin:4px 0;padding-left:18px&quot;&gt;&lt;li&gt;TCP 5432 ⬅ SG-EC2&lt;/li&gt;&lt;/ul&gt;Origem é o &lt;b&gt;security group&lt;/b&gt; da EC2, não um IP." vertex="1">
